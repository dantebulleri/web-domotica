---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ParaQuienEs from '../components/ParaQuienEs.astro';
import Kits from '../components/Kits.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import ProgramaInstaladores from '../components/ProgramaInstaladores.astro';
import Compatibilidad from '../components/Compatibilidad.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="DomotiCA Rosario | Kits domóticos para instaladores B2B – Tuya, Zigbee"
  description="Distribuidor B2B de kits domóticos Tuya/Smart Life y Zigbee en Rosario. Margen preferencial para instaladores eléctricos, constructoras y empresas de seguridad. Soporte técnico local."
>
  <Header />
  <main>
    <Hero />
    <ParaQuienEs />
    <Kits />
    <ComoFunciona />
    <ProgramaInstaladores />
    <Compatibilidad />
    <FAQ />
    <Contacto />
    <Disclaimer />
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
