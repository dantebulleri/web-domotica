---
// TODO: Reemplazar número de WhatsApp
const WA_NUMBER = '5493413407451';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%2C%20quiero%20conocer%20las%20condiciones%20B2B%20para%20instaladores`;
---

<section class="bg-primary text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text content -->
      <div>
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 bg-accent/15 border border-accent/30 text-accent text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-accent rounded-full inline-block"></span>
          Distribución B2B · Rosario, Santa Fe
        </div>

        <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-5xl xl:text-6xl leading-tight mb-6">
          Kits domóticos<br />
          <span class="text-accent">listos para instalar</span><br />
          en cada obra.
        </h1>

        <p class="text-white/70 text-lg leading-relaxed mb-8 max-w-xl">
          Somos tu distribuidor local de soluciones Tuya/Smart Life y Zigbee en Rosario.
          Condiciones preferenciales para instaladores eléctricos, empresas de seguridad
          y constructoras. Sin intermediarios, con soporte técnico real.
        </p>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-6 mb-10 text-sm">
          <div class="flex items-center gap-2 text-white/60">
            <svg width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>Entrega en Rosario y zona</span>
          </div>
          <div class="flex items-center gap-2 text-white/60">
            <svg width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <span>Soporte técnico local</span>
          </div>
          <div class="flex items-center gap-2 text-white/60">
            <svg width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
            <span>Programa de partners</span>
          </div>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 bg-accent text-primary font-semibold px-6 py-3.5 rounded-xl hover:bg-accent/90 transition-all duration-200 text-sm"
          >
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Coordinar reunión
          </a>
          <a
            href="/catalogo.pdf"
            download
            class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-xl hover:bg-white/15 transition-all duration-200 text-sm"
          >
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Descargar catálogo PDF
          </a>
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-[#25D366]/15 border border-[#25D366]/40 text-[#25D366] font-semibold px-6 py-3.5 rounded-xl hover:bg-[#25D366]/25 transition-all duration-200 text-sm"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Soy instalador – Quiero condiciones
          </a>
        </div>
      </div>

      <!-- Visual / Illustration -->
      <div class="relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-md">
          <!-- Main card -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm">
            <div class="flex items-center gap-3 mb-5 pb-4 border-b border-white/10">
              <div class="w-10 h-10 rounded-xl bg-accent/20 flex items-center justify-center">
                <svg width="20" height="20" fill="none" stroke="#2DBE7E" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-semibold text-sm">Catálogo B2B activo</p>
                <p class="text-white/40 text-xs">3 soluciones disponibles</p>
              </div>
            </div>
            <div class="space-y-3">
              {[
                { name: 'Starter – Iluminación Smart', badge: 'Tuya WiFi', color: 'bg-blue-500/20 text-blue-300' },
                { name: 'Kit Riego Inteligente', badge: 'WiFi', color: 'bg-accent/20 text-accent' },
                { name: 'Kit Departamento Smart', badge: 'Zigbee', color: 'bg-purple-500/20 text-purple-300' },
              ].map(kit => (
                <div class="flex items-center justify-between bg-white/5 rounded-xl px-4 py-3">
                  <span class="text-white/80 text-sm">{kit.name}</span>
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${kit.color}`}>{kit.badge}</span>
                </div>
              ))}
            </div>
            <div class="mt-5 pt-4 border-t border-white/10">
              <p class="text-white/40 text-xs text-center">
                Precios B2B disponibles previa reunión comercial
              </p>
            </div>
          </div>

          <!-- Floating chip -->
          <div class="absolute -top-4 -right-4 bg-accent text-primary text-xs font-bold px-3 py-1.5 rounded-full shadow-lg">
            Rosario, Santa Fe
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
