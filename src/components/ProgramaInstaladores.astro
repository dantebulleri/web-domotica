---
// TODO: Reemplazar número de WhatsApp
const WA_NUMBER = '5493413000000';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%2C%20quiero%20unirme%20al%20programa%20de%20instaladores%20partner`;

const beneficios = [
  {
    icono: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>`,
    titulo: 'Margen preferencial',
    desc: 'Precios de canal diferenciados según volumen. A mayor recurrencia, mejor precio.',
  },
  {
    icono: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>`,
    titulo: 'Capacitación express',
    desc: 'Guías PDF + videos cortos por kit. Sin cursos largos: instalás en la primera vez.',
  },
  {
    icono: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`,
    titulo: 'Soporte técnico por WhatsApp',
    desc: 'Canal directo en horario hábil. Si tenés una duda en obra, te respondemos ese mismo día.',
  },
  {
    icono: `<svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    titulo: 'Entrega local en Rosario',
    desc: 'Coordinamos entrega en Rosario y zona sin costo de envío en pedidos desde cierto volumen. Sin demoras de correo.',
  },
];
---

<section id="programa" class="bg-primary text-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-14 items-center">
      <!-- Left: content -->
      <div>
        <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-4">Programa de instaladores</p>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl leading-tight mb-5">
          Sumate al canal de<br />
          <span class="text-accent">partners técnicos</span>
        </h2>
        <p class="text-white/70 leading-relaxed mb-8">
          Si instalás regularmente en Rosario y querés agregar domótica a tu oferta de servicio,
          el programa de instaladores partner te da acceso a precios diferenciados, capacitación
          y soporte técnico real. No es un club de fidelización: es una relación comercial directa.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-accent text-primary font-semibold px-6 py-3.5 rounded-xl hover:bg-accent/90 transition-all text-sm"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Quiero ser instalador partner
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center justify-center gap-2 bg-white/10 border border-white/20 text-white font-semibold px-6 py-3.5 rounded-xl hover:bg-white/15 transition-all text-sm"
          >
            Coordinar reunión
          </a>
        </div>
      </div>

      <!-- Right: benefits grid -->
      <div class="grid sm:grid-cols-2 gap-4">
        {beneficios.map(b => (
          <div class="bg-white/5 border border-white/10 rounded-xl p-5 hover:bg-white/8 transition-colors">
            <div class="w-10 h-10 rounded-lg bg-accent/15 text-accent flex items-center justify-center mb-3" set:html={b.icono} />
            <h3 class="font-heading font-semibold text-white text-base mb-1.5">{b.titulo}</h3>
            <p class="text-white/60 text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
