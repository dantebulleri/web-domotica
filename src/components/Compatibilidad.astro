---
const ecosistemas = [
  {
    logo: 'Tuya / Smart Life',
    descripcion: 'La plataforma base de nuestros kits WiFi. La app Smart Life es gratuita, disponible en iOS y Android, y permite control remoto, automatizaciones y escenas.',
    compatible: ['Mini switches WiFi', 'Controlador de riego', 'Sensores WiFi'],
    color: 'border-orange-200 bg-orange-50',
    textColor: 'text-orange-700',
    dot: 'bg-orange-400',
  },
  {
    logo: 'Alexa / Google Home',
    descripcion: 'Todos nuestros dispositivos Tuya son compatibles con Alexa y Google Assistant mediante la integración oficial de Smart Life. Control por voz sin configuración extra.',
    compatible: ['Switches WiFi Tuya', 'Hub Zigbee', 'Automatizaciones'],
    color: 'border-blue-200 bg-blue-50',
    textColor: 'text-blue-700',
    dot: 'bg-blue-400',
  },
  {
    logo: 'Zigbee (via hub)',
    descripcion: 'El protocolo Zigbee ofrece mayor alcance, menor latencia y no satura la red WiFi del hogar. Requiere el hub Zigbee incluido en el Kit Departamento Smart.',
    compatible: ['Switches de pared Zigbee', 'Sensor de puerta', 'Sensor de movimiento'],
    color: 'border-purple-200 bg-purple-50',
    textColor: 'text-purple-700',
    dot: 'bg-purple-400',
  },
];

const notas = [
  'Todos los dispositivos requieren conectividad WiFi 2.4 GHz en el local. No son compatibles con redes 5 GHz sin modo dual.',
  'Los dispositivos Zigbee no funcionan de forma autónoma sin el hub. El hub Zigbee sí requiere conexión WiFi.',
  'La integración con Alexa y Google Home es a través de la app Smart Life. No requiere ningún hardware adicional.',
  'No somos responsables por cambios en las APIs de terceros (Google, Amazon, Tuya) que puedan afectar la compatibilidad.',
];
---

<section id="compatibilidad" class="bg-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-3">Compatibilidad</p>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-primary">
        ¿Con qué ecosistemas trabajan<br class="hidden sm:block" /> nuestros kits?
      </h2>
      <p class="mt-4 text-gray-500 max-w-xl mx-auto">
        Sin conversiones ni adaptadores raros. Todo funciona con apps que el cliente
        ya conoce o con las que se puede capacitar en minutos.
      </p>
    </div>

    <!-- Ecosistemas grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-12">
      {ecosistemas.map(eco => (
        <div class={`border rounded-2xl p-6 ${eco.color}`}>
          <div class="flex items-center gap-2 mb-4">
            <span class={`w-2.5 h-2.5 rounded-full ${eco.dot}`}></span>
            <h3 class={`font-heading font-bold text-lg ${eco.textColor}`}>{eco.logo}</h3>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed mb-4">{eco.descripcion}</p>
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Dispositivos</p>
            <ul class="space-y-1">
              {eco.compatible.map(item => (
                <li class="flex items-center gap-1.5 text-sm text-gray-600">
                  <svg width="12" height="12" fill="none" stroke="#2DBE7E" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Tabla de compatibilidad rápida -->
    <div class="bg-bgalt rounded-2xl p-6 mb-8 overflow-x-auto">
      <h3 class="font-heading font-semibold text-primary mb-4 text-lg">Tabla de compatibilidad rápida</h3>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="text-left py-2 pr-4 text-gray-500 font-medium">Kit</th>
            <th class="text-center py-2 px-3 text-gray-500 font-medium">Smart Life</th>
            <th class="text-center py-2 px-3 text-gray-500 font-medium">Alexa</th>
            <th class="text-center py-2 px-3 text-gray-500 font-medium">Google Home</th>
            <th class="text-center py-2 px-3 text-gray-500 font-medium">Zigbee</th>
          </tr>
        </thead>
        <tbody>
          {[
            { kit: 'Starter – Iluminación Smart', sl: true, alexa: true, google: true, zigbee: false },
            { kit: 'Kit Riego Inteligente', sl: true, alexa: true, google: true, zigbee: false },
            { kit: 'Kit Departamento Smart', sl: true, alexa: true, google: true, zigbee: true },
          ].map(row => (
            <tr class="border-b border-gray-100 last:border-0">
              <td class="py-3 pr-4 text-gray-700 font-medium">{row.kit}</td>
              {[row.sl, row.alexa, row.google, row.zigbee].map(val => (
                <td class="py-3 px-3 text-center">
                  {val
                    ? <span class="text-accent text-lg">✓</span>
                    : <span class="text-gray-300 text-lg">—</span>
                  }
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Notas técnicas -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
      <div class="flex items-start gap-3">
        <svg class="flex-shrink-0 mt-0.5" width="18" height="18" fill="none" stroke="#D97706" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <p class="text-amber-800 font-semibold text-sm mb-2">Consideraciones técnicas</p>
          <ul class="space-y-1">
            {notas.map(nota => (
              <li class="text-amber-700 text-sm leading-relaxed">• {nota}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
