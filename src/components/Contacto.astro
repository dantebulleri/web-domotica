---
// TODO: Reemplazar FORMSPREE_ID con tu ID real de Formspree (https://formspree.io)
// Pasos: 1) Crear cuenta en formspree.io  2) Crear nuevo form  3) Copiar el ID (ej: xpwzaabc)
// Si no usás Formspree, descomentar la versión mailto más abajo.
const FORMSPREE_ID = 'mlgwwopw';
const FORM_ACTION = `https://formspree.io/f/${FORMSPREE_ID}`;

// Alternativa mailto (sin backend):
// const FORM_ACTION = 'mailto:tu@email.com?subject=Contacto Web B2B';

// TODO: Reemplazar número de WhatsApp
const WA_NUMBER = '5493413407451';
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=Hola%2C%20me%20contacto%20desde%20la%20web%20para%20consultar%20condiciones%20B2B`;
---

<section id="contacto" class="bg-white py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <!-- Left: info -->
      <div>
        <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-4">Contacto B2B</p>
        <h2 class="font-heading font-bold text-3xl sm:text-4xl text-primary mb-5">
          Hablemos
        </h2>
        <p class="text-gray-500 leading-relaxed mb-8">
          Si sos instalador, constructora o técnico y querés incorporar soluciones
          domóticas a tus proyectos, coordinemos una reunión.
        </p>

        <!-- Contact options -->
        <div class="space-y-4 mb-8">
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 border border-gray-100 rounded-xl hover:border-accent/30 hover:bg-accent/5 transition-all group"
          >
            <div class="w-11 h-11 rounded-xl bg-[#25D366]/10 flex items-center justify-center text-[#25D366]">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-primary text-sm group-hover:text-accent transition-colors">WhatsApp directo</p>
              <p class="text-gray-400 text-xs">Respuesta rápida en horario hábil</p>
            </div>
            <svg class="ml-auto" width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>

          <div class="flex items-center gap-4 p-4 border border-gray-100 rounded-xl">
            <div class="w-11 h-11 rounded-xl bg-primary/8 flex items-center justify-center">
              <svg width="20" height="20" fill="none" stroke="#1E2A38" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-primary text-sm">Rosario, Santa Fe</p>
              <p class="text-gray-400 text-xs">Reuniones presenciales o por videollamada</p>
            </div>
          </div>

          <a
            href="/DOMOTICA_ROSARIO_CATALOGO_2025.pdf"
            download
            class="flex items-center gap-4 p-4 border border-gray-100 rounded-xl hover:border-accent/30 hover:bg-accent/5 transition-all group"
          >
            <div class="w-11 h-11 rounded-xl bg-accent/10 flex items-center justify-center text-accent">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-primary text-sm group-hover:text-accent transition-colors">Descargar catálogo PDF</p>
              <p class="text-gray-400 text-xs">Kits, specs y condiciones generales</p>
            </div>
            <svg class="ml-auto" width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: form -->
      <div class="bg-bgalt rounded-2xl p-7 lg:p-8">
        <form
          action={FORM_ACTION}
          method="POST"
          id="contact-form"
          class="space-y-5"
        >
          <!-- Nombre -->
          <div>
            <label for="nombre" class="block text-sm font-medium text-primary mb-1.5">
              Nombre completo <span class="text-red-400">*</span>
            </label>
            <input
              type="text"
              id="nombre"
              name="nombre"
              required
              placeholder="Juan García"
              class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
            />
          </div>

          <!-- Empresa -->
          <div>
            <label for="empresa" class="block text-sm font-medium text-primary mb-1.5">
              Empresa / Nombre comercial
            </label>
            <input
              type="text"
              id="empresa"
              name="empresa"
              placeholder="García Instalaciones Eléctricas"
              class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
            />
          </div>

          <!-- Rol + Ciudad (2 cols) -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="rol" class="block text-sm font-medium text-primary mb-1.5">
                Rol <span class="text-red-400">*</span>
              </label>
              <select
                id="rol"
                name="rol"
                required
                class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
              >
                <option value="" disabled selected>Seleccioná...</option>
                <option value="instalador-electrico">Instalador eléctrico</option>
                <option value="constructora">Constructora / Estudio</option>
                <option value="empresa-seguridad">Empresa de seguridad</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label for="ciudad" class="block text-sm font-medium text-primary mb-1.5">
                Ciudad
              </label>
              <input
                type="text"
                id="ciudad"
                name="ciudad"
                placeholder="Rosario"
                class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
              />
            </div>
          </div>

          <!-- Teléfono + Email (2 cols) -->
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="telefono" class="block text-sm font-medium text-primary mb-1.5">
                Teléfono / WhatsApp <span class="text-red-400">*</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                required
                placeholder="+54 341 000-0000"
                class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-primary mb-1.5">
                Email <span class="text-red-400">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="juan@empresa.com"
                class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors"
              />
            </div>
          </div>

          <!-- Mensaje -->
          <div>
            <label for="mensaje" class="block text-sm font-medium text-primary mb-1.5">
              Mensaje (opcional)
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              rows="3"
              placeholder="Ej: Hago instalaciones residenciales en Rosario norte y quiero ampliar mi oferta con domótica..."
              class="w-full px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm text-ink placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Honeypot anti-spam (hidden) -->
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-accent text-primary font-semibold px-6 py-3.5 rounded-xl hover:bg-accent/90 transition-all text-sm flex items-center justify-center gap-2"
          >
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Enviar y coordinar reunión
          </button>

          <!-- Success / error messages -->
          <div id="form-success" class="hidden bg-accent/10 border border-accent/30 rounded-xl p-4 text-center">
            <p class="text-accent font-semibold text-sm">✓ Mensaje enviado correctamente</p>
            <p class="text-gray-600 text-xs mt-1">Te respondemos en 24 hs hábiles.</p>
          </div>
          <div id="form-error" class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-center">
            <p class="text-red-600 font-semibold text-sm">Hubo un error al enviar</p>
            <p class="text-red-500 text-xs mt-1">Por favor escribinos directamente por WhatsApp.</p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('form-success') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;

  // Solo usamos fetch si el action no es mailto:
  if (form && !form.action.startsWith('mailto:')) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Enviando...';

      try {
        const data = new FormData(form);
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          form.reset();
          successMsg.classList.remove('hidden');
          errorMsg.classList.add('hidden');
        } else {
          throw new Error('Server error');
        }
      } catch {
        errorMsg.classList.remove('hidden');
        successMsg.classList.add('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg> Enviar y coordinar reunión`;
      }
    });
  }
</script>
