---
const perfiles = [
  {
    icon: `<svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    titulo: 'Stock Local',
    descripcion: 'Disponibilidad inmediata en Rosario y envíos a todo el país.',
    puntos: [
      'Sin demoras de importación',
      'Pedidos por proyecto o pequeño stock',
      'Entrega coordinada en Rosario y zona',
    ],
  },
  {
    icon: `<svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/></svg>`,
    titulo: 'Soporte Técnico',
    descripcion: 'Asistencia por WhatsApp en horario comercial y documentación técnica incluida.',
    puntos: [
      'Canal directo por WhatsApp',
      'Guías de instalación PDF + video',
      'Respuesta el mismo día hábil',
    ],
  },
  {
    icon: `<svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    titulo: 'Compatibilidad Garantizada',
    descripcion: 'Productos compatibles con Tuya / Smart Life y asistentes de voz.',
    puntos: [
      'Compatible con Alexa y Google Home',
      'Integración nativa con Smart Life',
      'Protocolo WiFi y Zigbee disponibles',
    ],
  },
];
---

<section id="para-quien" class="bg-bgalt py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-14">
      <p class="text-accent font-semibold text-sm uppercase tracking-widest mb-3">Por qué elegirnos</p>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl text-primary">
        Trabajamos para profesionales
      </h2>
      <p class="mt-4 text-gray-500 max-w-xl mx-auto">
        Canal exclusivo B2B. Trabajamos con instaladores, constructoras y técnicos
        que necesitan productos confiables, soporte real y entrega sin demoras.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6">
      {perfiles.map(p => (
        <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-300 flex flex-col">
          <div class="w-12 h-12 bg-primary/8 rounded-xl flex items-center justify-center text-primary mb-5" set:html={p.icon} />
          <h3 class="font-heading font-bold text-xl text-primary mb-3">{p.titulo}</h3>
          <p class="text-gray-500 text-sm leading-relaxed mb-5">{p.descripcion}</p>
          <ul class="mt-auto space-y-2">
            {p.puntos.map(punto => (
              <li class="flex items-start gap-2 text-sm text-gray-600">
                <svg class="flex-shrink-0 mt-0.5" width="16" height="16" fill="none" stroke="#2DBE7E" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
                {punto}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 bg-primary text-white font-semibold px-7 py-3.5 rounded-xl hover:bg-primary/90 transition-colors text-sm"
      >
        Quiero ser Instalador Partner
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
